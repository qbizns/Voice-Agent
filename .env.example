# Application Settings
APP_NAME=Voice Agent
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# Server Settings
HOST=0.0.0.0
PORT=8000

# Audio Settings
SAMPLE_RATE=16000
CHANNELS=1
CHUNK_SIZE=4096
AUDIO_FORMAT=int16

# Speech-to-Text Settings
STT_ENGINE=vosk  # Options: vosk, whisper
VOSK_MODEL_PATH=models/vosk-model-ar-0.22-linto
WHISPER_MODEL=base  # Options: tiny, base, small, medium, large
WHISPER_LANGUAGE=ar

# Text-to-Speech Settings
TTS_ENGINE=edge  # Options: edge, coqui
TTS_VOICE=ar-EG-SalmaNeural  # Arabic Egyptian voice
TTS_RATE=+0%
TTS_VOLUME=+0%

# Knowledge Base Settings
KNOWLEDGE_BASE_PATH=knowledge_base
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
VECTOR_DB=faiss  # Options: faiss, chromadb
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=3

# AI Agent Settings
LLM_PROVIDER=ollama  # Options: ollama, local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2:7b
TEMPERATURE=0.7
MAX_TOKENS=500

# System Prompt
SYSTEM_PROMPT=أنت مساعد ذكي ومفيد. تجيب على الأسئلة بناءً على قاعدة المعرفة المتوفرة. كن واضحاً ومختصراً في إجاباتك.

# Performance Settings
VAD_ENABLED=true  # Voice Activity Detection
VAD_AGGRESSIVENESS=3  # 0-3, higher = more aggressive
SILENCE_THRESHOLD=500  # Milliseconds of silence to detect end of speech
